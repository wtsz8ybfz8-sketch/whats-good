# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Places API key for restaurant discovery.
# Browser apps expose VITE_* values to users, so restrict this key in Google Cloud:
# - Application restriction: HTTP referrers for your local/dev and production domains
# - API restriction: Places API (New) only
# - Billing/budget alerts enabled
VITE_GOOGLE_PLACES_KEY="YOUR_RESTRICTED_GOOGLE_PLACES_BROWSER_KEY"

# Accounts for the Saved tab (Supabase magic link).
# The project and the saved_items table ALREADY EXIST — ref jpgycbnpfckabkjhyzbk, created
# by the Lovable build. Only the browser key is missing. Either name works; the Lovable
# export used PUBLISHABLE. NEVER the service_role key. See docs/ACCOUNTS-SETUP.md
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# VITE_SUPABASE_ANON_KEY="<legacy anon JWT>"
# VITE_SUPABASE_URL — optional, defaults to the project above
